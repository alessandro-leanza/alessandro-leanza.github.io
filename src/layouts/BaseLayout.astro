---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  pageTitle?: string;
  socialImage?: string;
}
const { title, description, home = false, pageTitle = `${title} | Alessandro Leanza`, socialImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const previewImage = socialImage ? new URL(socialImage, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content={previewImage ? 'summary_large_image' : 'summary'} />
    {previewImage && <meta property="og:image" content={previewImage} />}
    {previewImage && <meta property="og:image:alt" content={`${title} — project figure`} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={['container', { 'inner-page': !home }]} tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
