---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { conceptbot } from '../data/conceptbot';
import { graphrag } from '../data/graphrag';
import { exoskeleton } from '../data/exoskeleton';
---
<BaseLayout title="Projects">
  <h1>Projects</h1>
  <div class="project-grid">
    <ProjectCard
      title="ConceptBot"
      description="Knowledge-graph-grounded commonsense reasoning for LLM-based robot task planning."
      tags={['Knowledge Graphs', 'LLM Planning', 'Robot Planning']}
      href="/projects/conceptbot/"
      image={conceptbot.media.qualitative}
      imageAlt="ConceptBot planning pipeline and robot execution compared with SayCan"
    />
    <ProjectCard
      title={exoskeleton.title}
      description={exoskeleton.cardDescription}
      tags={exoskeleton.tags}
      href={exoskeleton.path}
    />
    <ProjectCard
      title={graphrag.title}
      description="Local, provenance-aware retrieval and knowledge graphs for grounded robot task decomposition."
      tags={['RAG', 'Knowledge graphs']}
      href="/projects/graphrag/"
      image={graphrag.architecture}
      imageAlt="Provenance-aware graph construction, retrieval, and local robot task planning"
    />
  </div>
</BaseLayout>
