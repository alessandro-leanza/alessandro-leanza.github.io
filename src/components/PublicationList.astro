---
import { selectedPublications, type Publication } from '../data/publications';
interface Props {
  publications?: Publication[];
}
const { publications = selectedPublications } = Astro.props;
---
<ol class="publication-list" aria-label="Selected publications">
  {publications.map((publication, index) => (
    <li>
      <span class="publication-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{publication.paper ? <a href={publication.paper}>{publication.title}</a> : publication.title}</h3>
        <p>{publication.authors.join(', ')}</p>
        <p class="publication-status">{publication.status}</p>
        <p>{publication.citationLabel}</p>
        <div class="publication-links">
          {publication.paper && <a href={publication.paper}>Paper</a>}
          {publication.project && <a href={publication.project}>Project</a>}
          {publication.code && <a href={publication.code}>Code</a>}
        </div>
      </div>
    </li>
  ))}
</ol>
