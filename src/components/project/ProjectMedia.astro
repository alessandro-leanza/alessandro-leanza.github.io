---
import { existsSync } from 'node:fs';
import { resolve, sep } from 'node:path';
interface Props {
  label: string;
  image?: string;
  video?: string;
  poster?: string;
  alt?: string;
  compact?: boolean;
}
const { label, image, video, poster, alt = label, compact = false } = Astro.props;
const publicRoot = resolve('public');
// Only emit paths for files present at build time inside public/.
function available(path: string | undefined) {
  if (!path || !path.startsWith('/') || path.startsWith('//')) return false;
  const resolved = resolve(publicRoot, path.slice(1));
  return resolved.startsWith(publicRoot + sep) && existsSync(resolved);
}
const hasVideo = available(video) && /\.(mp4|webm)$/i.test(video!) && available(poster);
const hasImage = available(image);
---
<figure class:list={['project-media', { 'project-media-compact': compact }]}>
  {hasVideo ? (
    <video controls muted loop playsinline preload="none" poster={poster} aria-label={alt}>
      <source src={video} type={video!.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
      Your browser does not support this video.
    </video>
  ) : hasImage ? (
    <img src={image} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <div class="project-media-placeholder">
      <span class="eyebrow">Media placeholder</span>
      <span>{label}</span>
    </div>
  )}
  {(hasVideo || hasImage) && <figcaption>{label}</figcaption>}
</figure>
<!-- Videos start paused, including for reduced-motion users. Native controls
     provide explicit playback and pause; autoplay is intentionally omitted. -->
