---
import { publicAssetExists } from '../../utils/publicAsset';
interface Props {
  label: string;
  image?: string;
  video?: string;
  poster?: string;
  alt?: string;
  compact?: boolean;
  size?: 'full' | 'medium' | 'small';
  muted?: boolean;
  loop?: boolean;
}
const { label, image, video, poster, alt = label, compact = false, size = 'full', muted = true, loop = true } = Astro.props;
const hasVideo = publicAssetExists(video) && /\.(mp4|webm)$/i.test(video!) && publicAssetExists(poster);
const hasImage = publicAssetExists(image);
---
<figure class:list={['project-media', `project-media-${size}`, { 'project-media-compact': compact }]}>
  {hasVideo ? (
    <video controls muted={muted} loop={loop} playsinline preload="none" poster={poster} aria-label={alt}>
      <source src={video} type={video!.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
      Your browser does not support this video.
    </video>
  ) : hasImage ? (
    <a href={image} class="project-figure-link" aria-label={`${label} — open full-size image`}>
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    </a>
  ) : (
    <div class="project-media-placeholder">
      <span class="eyebrow">Media placeholder</span>
      <span>{label}</span>
    </div>
  )}
  {(hasVideo || hasImage) && <figcaption>{label}{hasImage && !hasVideo && <span class="figure-size-hint" aria-hidden="true">Open full size ↗</span>}</figcaption>}
</figure>
<!-- Videos start paused, including for reduced-motion users. Native controls
     provide explicit playback and pause; autoplay is intentionally omitted. -->
