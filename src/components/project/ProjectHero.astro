---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  intro: string;
  authors: string[];
  paper: string;
  code: string;
}
const { eyebrow, title, subtitle, intro, authors, paper, code } = Astro.props;
---
<header class="project-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="project-subtitle">{subtitle}</p>
  <p class="project-intro">{intro}</p>
  <p class="project-authors"><span class="sr-only">Authors: </span>{authors.join(' · ')}</p>
  <div class="hero-actions">
    <a class="button button-primary" href={paper}>Paper</a>
    <a class="button" href={code}>Code</a>
    <a class="text-link" href="#citation">BibTeX <span aria-hidden="true">↓</span></a>
  </div>
</header>
