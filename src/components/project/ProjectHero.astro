---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  publicationStatus?: string;
  publicationVenueUrl?: string;
  intro: string;
  authors?: string[];
  paper?: string;
  paperLabel?: string;
  code?: string;
  showCitation?: boolean;
}
const { eyebrow, title, subtitle, publicationStatus, publicationVenueUrl, intro, authors = [], paper, paperLabel = 'Paper', code, showCitation = true } = Astro.props;
---
<header class="project-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="project-subtitle">{subtitle}</p>
  {publicationStatus && <p class="project-publication-status">{publicationVenueUrl ? <a href={publicationVenueUrl}>{publicationStatus}</a> : publicationStatus}</p>}
  <p class="project-intro">{intro}</p>
  {authors.length > 0 && <p class="project-authors"><span class="sr-only">Authors: </span>{authors.join(' · ')}</p>}
  <div class="hero-actions">
    {paper && <a class="button button-primary" href={paper}>{paperLabel}</a>}
    {code && <a class:list={['button', { 'button-primary': !paper }]} href={code}>Code</a>}
    {showCitation && <a class="text-link" href="#citation">BibTeX <span aria-hidden="true">↓</span></a>}
  </div>
</header>
