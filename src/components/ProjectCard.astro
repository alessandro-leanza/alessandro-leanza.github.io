---
import ArrowIcon from './ArrowIcon.astro';
import { publicAssetExists } from '../utils/publicAsset';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}
const { title, description, tags = [], href, image, imageAlt = title } = Astro.props;
const hasImage = publicAssetExists(image);
---
<article class:list={['project-card', { 'project-card-linked': !!href }]}>
  <div class:list={['project-image', { 'project-image-has-media': hasImage }]}>
    {hasImage ? (
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <><span class="image-corner" aria-hidden="true"></span>
      <span>Project image <span aria-hidden="true">/</span> placeholder</span></>
    )}
  </div>
  <div class="project-body">
    <h3>{href ? <a href={href} aria-label={`View ${title} project`}>{title}<ArrowIcon /></a> : title}</h3>
    <p>{description}</p>
    {tags.length > 0 && <ul class="tags" aria-label="Research topics">{tags.map(tag => <li>{tag}</li>)}</ul>}
  </div>
</article>
