---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string;
}
const { title, description, tags = [], href } = Astro.props;
---
<article class:list={['project-card', { 'project-card-linked': !!href }]}>
  <div class="project-image" aria-label="Project image placeholder">
    <span class="image-corner" aria-hidden="true"></span>
    <span>Project image <span aria-hidden="true">/</span> placeholder</span>
  </div>
  <div class="project-body">
    <h3>{href ? <a href={href}>{title}<ArrowIcon /></a> : title}</h3>
    <p>{description}</p>
    {tags.length > 0 && <ul class="tags" aria-label="Research topics">{tags.map(tag => <li>{tag}</li>)}</ul>}
  </div>
</article>
